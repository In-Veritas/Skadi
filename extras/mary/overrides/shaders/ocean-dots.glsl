// Água com órbitas de onda e corpo independente de pontos nadando através dela.
const float SEA_OPACITY = 0.24;
const float SEA_HORIZON = 0.60;
const float GRID = 24.0;
const float CAMERA = 560.0;
const float EVENT_SECONDS = 72.0;
const float WEATHER_SECONDS = 28.0;
const float PROMPT_LIFT_PX = 3.0;
const float TRAIL_SECONDS = 0.55;
const vec3 OCEAN_BLUE = vec3(0.20, 0.52, 1.00);
const vec3 TURQUOISE = vec3(0.15, 0.90, 0.80);

// A cor 251 controla a revelação; a cor 250 controla a saída após digitar.
// Não depende do relógio da janela: cada nova sessão começa a intro do zero.
float introProgress() {
    vec3 control = round(iPalette[251] * 255.0);
    return control.r == 17.0 ? (control.g * 256.0 + control.b) / 65535.0 : -1.0;
}

float introWaterVisibility(vec2 world) {
    float progress = introProgress();
    if (progress < 0.0) return 1.0;
    float reveal = clamp((progress * 13.6 - 5.8) / 3.4, 0.0, 1.0);
    if (reveal <= 0.0) return 0.0;
    if (reveal >= 1.0) return 1.0;
    float d = CAMERA / (CAMERA + world.y);
    float screenX = iResolution.x * 0.5 + world.x * d;
    float columns = ceil(iResolution.x / GRID);
    float column = clamp(floor(screenX / GRID), 0.0, columns - 1.0);
    // Colunas verticais da tela, esquerda -> direita; cada uma nasce do
    // horizonte para baixo. O ID usa a posição de repouso, não a onda móvel.
    float row = clamp((d - 0.025) / 0.975, 0.0, 1.0);
    float withinColumn = fract(screenX / GRID);
    float birth = (column + row * 0.80 + withinColumn * 0.16) / columns;
    // Cada ponto ganha opacidade durante 240 ms. Colunas se sobrepõem
    // suavemente, sem a troca quase instantânea de blocos inteiros.
    float seconds = progress * 13.6;
    return smoothstep(5.8 + birth * 3.15, 6.04 + birth * 3.15, seconds);
}

